/* ============ Routing ============ */
const routes = {
  'login': { title: '登录', page: 'page-login', hasShell: false },
  'zero_screen': { title: '零碳大屏', page: 'page-zero-screen', hasShell: false },
  'cockpit': { title: '综合看板', page: 'page-cockpit', hasShell: true },
  'efficiency': { title: '能效分析', page: 'page-efficiency', hasShell: true },
  'carbon': { title: '碳排分析', page: 'page-carbon', hasShell: true },
  'green_development': { title: '绿色发展', page: 'page-green-development', hasShell: true },
  'virtual_plant': { title: '虚拟电厂', page: 'page-virtual-plant', hasShell: true },
  'report': { title: '报告中心', page: 'page-report', hasShell: true },
  'alert-center': { title: '预警中心', page: 'page-alert-center', hasShell: true },
  'alert-detail': { title: '预警详情', page: 'page-alert-detail', hasShell: true },
  'payload_manage': { title: '零碳考核', page: 'page-payload-manage', hasShell: true },
  'system_settings': { title: '系统设置', page: 'page-system-settings', hasShell: true },
};

let currentRoute = null;
let chartsInitialized = {};

/* ===== 登录态守卫：未通过登录校验不得进入任何业务页面 ===== */
var ZC_AUTH_KEY = 'zc_demo_authed';
function zcSetAuthed(v) {
  try { sessionStorage.setItem(ZC_AUTH_KEY, v ? '1' : '0'); } catch (e) { window.__zcAuthed = !!v; }
}
function zcIsAuthed() {
  try { return sessionStorage.getItem(ZC_AUTH_KEY) === '1'; } catch (e) { return window.__zcAuthed === true; }
}

function getRoute() {
  const rawHash = location.hash.replace('#', '') || 'login';
  const raw = rawHash === 'zero-screen' ? 'zero_screen' : rawHash;
  // normalize hyphens → underscores for route keys
  const hash = raw.replace(/-(?=plant)/g, '_');
  return routes[hash] ? hash : 'login';
}

function goTo(hash) {
  if (hash.startsWith('#')) hash = hash.slice(1);
  /* 修复：离开大屏前先退出全屏，避免全屏大屏遮盖 app-shell 造成导航无响应 */
  if (document.fullscreenElement && hash !== 'zero-screen' && hash !== 'zero_screen') {
    document.exitFullscreen && document.exitFullscreen();
  }
  location.hash = hash;
}

function renderRoute() {
  const route = getRoute();
  const cfg = routes[route];

  /* 未登录访问业务页面 → 强制回到登录页 */
  if (route !== 'login' && !zcIsAuthed()) {
    if (location.hash && location.hash !== '#login') {
      showToast('请先登录后再访问系统', 'warning');
      setTimeout(function () { location.hash = 'login'; }, 0);
    }
    return showLoginPage();
  }

  /* 修复：从零碳大屏切换到任意其他页面时，若仍处于全屏，主动退出全屏。
     否则全屏的大屏元素会持续遮盖 app-shell，导致侧边栏菜单点击无反应。 */
  if (route !== 'zero_screen' && document.fullscreenElement) {
    document.exitFullscreen && document.exitFullscreen();
  }

  // 路由切换时回到顶部，不继承上一个菜单的滚动位置
  window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
  document.documentElement.scrollTop = 0;
  document.body.scrollTop = 0;

  // show/hide shell
  const shell = document.getElementById('app-shell');
  const loginPage = document.getElementById('page-login');

  if (cfg.hasShell) {
    shell.style.display = 'block';
    shell.scrollTop = 0;
    loginPage.classList.remove('active');
  } else {
    shell.style.display = 'none';
  }

  // show current page
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const pageEl = document.getElementById(cfg.page);
  if (pageEl) pageEl.classList.add('active');

  // update sidebar active state
  document.querySelectorAll('.nav-item[data-route]').forEach(item => {
    item.classList.toggle('active', item.dataset.route === route || 
      ((route === 'alert-detail') && item.dataset.route === 'alert'));
  });

  // update breadcrumb
  const bc = document.getElementById('breadcrumb-text');
  if (bc) bc.textContent = cfg.title;

  // update document title
  document.title = route === 'login' ? '登录 - 零碳园区能碳管理平台' : cfg.title + ' - 零碳园区能碳管理平台';

  // init charts for this page
  if (route !== currentRoute && cfg.hasShell) {
    currentRoute = route;
    // delay to ensure display is active so charts can measure correctly
    setTimeout(() => initChartsForPage(route), 50);
  } else if (!cfg.hasShell) {
    currentRoute = route;
  }
}

