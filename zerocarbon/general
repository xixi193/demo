function getAlertTrendOption() {
  const times = [];
  for (let h = 6; h <= 14; h++) {
    for (let m = 0; m < 60; m += 15) {
      times.push(`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`);
    }
  }
  times.push('14:15', '14:30');
  // generate a power curve that goes up and triggers threshold
  const power = [];
  times.forEach((t, i) => {
    const base = 260;
    let val = base;
    if (i < 8) val = base + i * 8;          // ramp up
    else if (i < 16) val = 290 + (i-8) * 5; // continue rising
    else if (i < 24) val = 310 + (i-16) * 10; // crosses threshold
    else val = 360 + Math.sin(i) * 15 + (i-24) * 2; // stays high
    power.push(Math.round(val * 10) / 10);
  });
  const threshold = times.map(() => 320);

  return {
    backgroundColor: 'transparent',
    tooltip: {
      trigger: 'axis',
      backgroundColor: 'rgba(255,255,255,0.98)',
      borderColor: 'rgba(31,45,58,0.10)',
      textStyle: { color: '#1f2d3a', fontSize: 12 },
      axisPointer: { type: 'line', lineStyle: { color: 'rgba(239, 83, 80, 0.4)' } },
