function z5Apply(){const w=document.getElementById('z5-map-world');if(!w)return;w.style.transform=`translate(calc(-50% + ${z5Map.x}px),calc(-50% + ${z5Map.y}px)) scale(${z5Map.scale})`;const l=document.getElementById('z5-zoom-label');if(l)l.textContent=Math.round(z5Map.scale*100)+'%'}
function z5Zoom(delta,cx,cy){const old=z5Map.scale,next=Math.max(z5Map.min,Math.min(z5Map.max,old+delta));if(next===old)return;z5Map.scale=next;z5Apply()}
function z5Reset(){Object.assign(z5Map,{scale:.82,x:0,y:0});z5Apply()}
function z5Select(ev,el){if(ev&&ev.stopPropagation)ev.stopPropagation();document.querySelectorAll('.z5-pin').forEach(x=>x.classList.remove('active'));el.classList.add('active');const set=(id,v)=>{const n=document.getElementById(id);if(n)n.textContent=v};set('zs-fn',el.dataset.name);set('zs-fp',el.dataset.load||el.dataset.power);set('zs-fc',el.dataset.carbonToday||el.dataset.carbon);set('zs-fe',el.dataset.score||el.dataset.eff);set('zs-fi',el.dataset.intensity||'--');set('zs-status-badge',el.dataset.level==='carbon-low'?'达标':(el.dataset.level==='carbon-mid'?'冲刺':'关注'));set('zs-points',el.dataset.points||'--');const card=document.getElementById('building-status-card');if(card){card.classList.remove('level-low','level-mid','level-high');card.classList.add((el.dataset.level||'carbon-low').replace('carbon-','level-'),'is-visible')}}
function z5Init(){const cam=document.getElementById('z5-map-camera');if(!cam||cam.dataset.ready)return;cam.dataset.ready='1';cam.addEventListener('wheel',e=>{e.preventDefault();z5Zoom(e.deltaY<0?.1:-.1)},{passive:false});cam.addEventListener('pointerdown',e=>{if(e.target.closest('.z5-pin'))return;z5Map.drag=true;z5Map.sx=e.clientX;z5Map.sy=e.clientY;z5Map.bx=z5Map.x;z5Map.by=z5Map.y;cam.classList.add('dragging');cam.setPointerCapture(e.pointerId)});cam.addEventListener('pointermove',e=>{if(!z5Map.drag)return;z5Map.x=z5Map.bx+(e.clientX-z5Map.sx);z5Map.y=z5Map.by+(e.clientY-z5Map.sy);z5Apply()});const up=e=>{z5Map.drag=false;cam.classList.remove('dragging')};cam.addEventListener('pointerup',up);cam.addEventListener('pointercancel',up);cam.addEventListener('dblclick',z5Reset);z5Apply()}
