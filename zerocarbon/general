function showToast(msg, type) {
  type = type || 'info';
  var toast = document.createElement('div');
  var colors = { success: '#22d39a', info: '#4fc3f7', warning: '#ffb74d', error: '#ef5350' };
  var icons = {
    success: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
