<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>零碳园区能碳管理平台 · 一体化 Demo</title>
<style>
  /* ========== Reset & Base ========== */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    font-family: "PingFang SC", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #050d14;
    color: #e6f0f5;
    min-width: 1280px;
    overflow-x: auto;
    -webkit-font-smoothing: antialiased;
    font-size: 14px;
    line-height: 1.5;
  }
  a { color: inherit; text-decoration: none; }
  button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
  input { font-family: inherit; }
  ul, ol { list-style: none; }

  /* ========== Design Tokens ========== */
  :root {
    --bg-deep: #050d14;
    --bg-panel: rgba(12, 28, 38, 0.6);
    --bg-card: rgba(18, 42, 56, 0.45);
    --bg-card-hover: rgba(24, 56, 74, 0.55);
    --border-glass: rgba(80, 200, 160, 0.12);
    --border-glass-strong: rgba(80, 200, 160, 0.22);
    --brand-primary: #22d39a;
    --brand-primary-light: #5ee6bd;
    --brand-primary-dark: #10a877;
    --brand-glow: rgba(34, 211, 154, 0.35);
    --accent-blue: #4fc3f7;
    --accent-orange: #ffb74d;
    --accent-red: #ef5350;
    --accent-purple: #ab92ff;
    --text-primary: #e6f0f5;
    --text-secondary: #8aa4b2;
    --text-tertiary: #5a7180;
    --text-disabled: #3a4a55;
    --grid-line: rgba(80, 200, 160, 0.08);
    --divider: rgba(80, 200, 160, 0.1);
    --shadow-glow: 0 0 40px rgba(34, 211, 154, 0.08);
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;

    /* ----- 浅色主题（仅作用于 app-shell 内页；零碳大屏与大屏全屏不受影响） -----
       通过 .app-shell-on 类重定向 token：把深色变量改为浅色取值，
       零碳大屏 (#page-zero-screen) 与全屏元素不挂在 app-shell 下，
       且 .zero-screen 系列样式全部硬编码深色，因此大屏视觉保持不变。 */
    --l-bg-deep: #f4f7f9;
    --l-bg-panel: #ffffff;
    --l-bg-card: #ffffff;
    --l-bg-card-hover: #f1f6f8;
    --l-border-glass: #e3eaef;
    --l-border-glass-strong: #cdd9e0;
    --l-brand-primary: #15a87a;
    --l-brand-primary-light: #1bb98a;
    --l-brand-primary-dark: #0f8f67;
    --l-brand-glow: rgba(21, 168, 122, 0.14);
    --l-accent-blue: #2f9bd6;
    --l-accent-orange: #d98a2b;
    --l-accent-red: #d9534a;
    --l-accent-purple: #8a72e6;
    --l-text-primary: #1f2d3a;
    --l-text-secondary: #5b6b78;
    --l-text-tertiary: #8a98a6;
    --l-text-disabled: #b6c1cb;
    --l-grid-line: rgba(21, 168, 122, 0.06);
    --l-divider: #e6edf2;
    --l-shadow-glow: 0 6px 24px rgba(31, 45, 58, 0.08);
    --l-input-bg: #ffffff;
    --l-shadow-card: 0 1px 2px rgba(31,45,58,0.04), 0 4px 16px rgba(31,45,58,0.06);
  }

  /* 仅在 app-shell 内页激活浅色主题：把全局 token 重定向为浅色取值。
     大屏 (#page-zero-screen) 不在 #app-shell 内，沿用原深色取值，保持不变。 */
  #app-shell,
  #page-login {
    --bg-deep: var(--l-bg-deep);
    --bg-panel: var(--l-bg-panel);
    --bg-card: var(--l-bg-card);
    --bg-card-hover: var(--l-bg-card-hover);
    --border-glass: var(--l-border-glass);
    --border-glass-strong: var(--l-border-glass-strong);
    --brand-primary: var(--l-brand-primary);
    --brand-primary-light: var(--l-brand-primary-light);
    --brand-primary-dark: var(--l-brand-primary-dark);
    --brand-glow: var(--l-brand-glow);
    --accent-blue: var(--l-accent-blue);
    --accent-orange: var(--l-accent-orange);
    --accent-red: var(--l-accent-red);
    --accent-purple: var(--l-accent-purple);
    --text-primary: var(--l-text-primary);
    --text-secondary: var(--l-text-secondary);
    --text-tertiary: var(--l-text-tertiary);
    --text-disabled: var(--l-text-disabled);
    --grid-line: var(--l-grid-line);
    --divider: var(--l-divider);
    --shadow-glow: var(--l-shadow-glow);
  }

  /* 登录页背景：跟随浅色主题（右侧已白底）；保留极淡的绿色光晕装饰 */
  #page-login {
    background: linear-gradient(135deg, #eef6f3 0%, #eaf2f7 100%);
  }

  /* ========== Background Decoration ========== */
  .bg-decoration {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .bg-decoration::before {
    content: '';
    position: absolute;
    top: -30%;
    left: -20%;
    width: 70%;
    height: 70%;
    background: radial-gradient(ellipse at center, rgba(34, 211, 154, 0.08) 0%, transparent 70%);
    filter: blur(80px);
  }
  .bg-decoration::after {
    content: '';
    position: absolute;
    bottom: -20%;
    right: -10%;
    width: 60%;
    height: 60%;
    background: radial-gradient(ellipse at center, rgba(79, 195, 247, 0.06) 0%, transparent 70%);
    filter: blur(100px);
  }
  .bg-grid {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-image:
      linear-gradient(rgba(80, 200, 160, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(80, 200, 160, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  /* ========== App Layout ========== */
  .app {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    background: var(--bg-deep);
    color: var(--text-primary);
  }

  /* ========== Sidebar ========== */
  .sidebar {
    width: 220px;
    flex-shrink: 0;
    background: #ffffff;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-right: 1px solid var(--border-glass);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
    box-shadow: 1px 0 0 rgba(31,45,58,0.03);
  }
  .sidebar-logo {
    padding: 24px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border-glass);
  }
  .sidebar-logo-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--brand-primary), var(--accent-blue));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px var(--brand-glow);
  }
  .sidebar-logo-icon svg { width: 22px; height: 22px; color: #ffffff; }
  .sidebar-logo-text {
    font-size: 16px;
    font-weight: 600;
    background: linear-gradient(135deg, #1f2d3a, var(--brand-primary-dark));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.5px;
  }
  .sidebar-nav {
    flex: 1;
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow-y: auto;
  }
  .nav-group-title {
    padding: 12px 12px 8px;
    font-size: 11px;
    color: var(--text-tertiary);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 500;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 13.5px;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }
  .nav-item:hover {
    background: rgba(21, 168, 122, 0.08);
    color: var(--text-primary);
  }
  .nav-item.active {
    background: linear-gradient(90deg, rgba(21, 168, 122, 0.14), rgba(21, 168, 122, 0.02));
    color: var(--brand-primary-dark);
    font-weight: 600;
  }
  .nav-item.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 18px;
    background: var(--brand-primary);
    border-radius: 0 3px 3px 0;
    box-shadow: 0 0 8px var(--brand-glow);
  }
  .nav-item svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
  .nav-badge {
    margin-left: auto;
    font-size: 10px;
    background: var(--accent-red);
    color: #fff;
    padding: 1px 6px;
    border-radius: 10px;
    font-weight: 500;
    line-height: 16px;
  }
  .sidebar-footer {
    padding: 16px;
    border-top: 1px solid var(--border-glass);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-primary-dark), var(--accent-blue));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
  }
  .user-info { flex: 1; min-width: 0; }
  .user-name { font-size: 13px; font-weight: 500; color: var(--text-primary); }
  .user-role { font-size: 11px; color: var(--text-tertiary); margin-top: 2px; }
  .btn-logout {
    padding: 6px;
    border-radius: 6px;
    color: var(--text-tertiary);
    transition: all 0.2s;
  }
  .btn-logout:hover { color: var(--accent-red); background: rgba(239, 83, 80, 0.08); }

  /* ========== Main ========== */
  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg-deep);
  }
  .topbar {
    height: 60px;
    background: #ffffff;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: 1px solid var(--border-glass);
    display: flex;
    align-items: center;
    padding: 0 28px;
    gap: 20px;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-tertiary);
    font-size: 13px;
  }
  .breadcrumb .current { color: var(--text-primary); font-weight: 500; }
  .breadcrumb svg { width: 14px; height: 14px; }
  .topbar-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .topbar-icon-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition: all 0.2s;
    position: relative;
  }
  .topbar-icon-btn:hover { background: rgba(21, 168, 122, 0.10); color: var(--brand-primary-dark); }
  .topbar-icon-btn svg { width: 18px; height: 18px; }
  .topbar-icon-btn .dot {
    position: absolute;
    top: 8px;
    right: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-red);
    box-shadow: 0 0 6px rgba(239, 83, 80, 0.6);
  }
  .date-picker {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border-glass);
    font-size: 12.5px;
    color: var(--text-secondary);
  }
  .date-picker svg { width: 14px; height: 14px; color: var(--brand-primary); }

  .page-content {
    flex: 1;
    padding: 24px 28px;
  }

  /* ========== Page show/hide ========== */
  .page { display: none; }
  .page.active { display: block; animation: fadeIn 0.35s ease; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ========== Glass Card ========== */
  .card {
    background: var(--bg-card);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    position: relative;
    overflow: hidden;
    box-shadow: var(--l-shadow-card);
  }
  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-glass-strong), transparent);
  }
  .card-header {
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--divider);
  }
  .card-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .card-title::before {
    content: '';
    width: 3px;
    height: 14px;
    background: linear-gradient(to bottom, var(--brand-primary), transparent);
    border-radius: 2px;
  }
  .card-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .card-body { padding: 16px 20px; }

  /* ========== Metric Cards (KPI) ========== */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }
  .kpi-card {
    background: var(--bg-card);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    padding: 20px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: var(--l-shadow-card);
  }
  .kpi-card:hover {
    border-color: var(--border-glass-strong);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(31,45,58,0.10);
  }
  .kpi-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--kpi-color, var(--brand-primary)), transparent);
    opacity: 0.6;
  }
  .kpi-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .kpi-label {
    font-size: 13px;
    color: var(--text-secondary);
    font-weight: 500;
  }
  .kpi-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--kpi-bg, rgba(34, 211, 154, 0.1));
    color: var(--kpi-color, var(--brand-primary));
  }
  .kpi-icon svg { width: 18px; height: 18px; }
  .kpi-value {
    font-size: 30px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.5px;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .kpi-value .unit {
    font-size: 13px;
    font-weight: 400;
    color: var(--text-tertiary);
    margin-left: 4px;
  }
  .kpi-foot {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
  }
  .kpi-trend {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 500;
  }
  .kpi-trend.up { color: var(--accent-red); background: rgba(217, 83, 74, 0.10); }
  .kpi-trend.down { color: var(--brand-primary-dark); background: rgba(21, 168, 122, 0.10); }
  .kpi-trend svg { width: 12px; height: 12px; }
  .kpi-compare { color: var(--text-tertiary); }

  /* ========== Grid Layouts ========== */
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }
  .grid-3-2 {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 16px;
    margin-bottom: 20px;
  }
  .grid-2-1 {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
  }

  /* ========== Chart ========== */
  .chart { width: 100%; height: 300px; }
  .chart-lg { height: 360px; }
  .chart-sm { height: 240px; }

  /* ========== Tabs ========== */
  .tabs {
    display: flex;
    gap: 4px;
    background: rgba(31,45,58,0.05);
    padding: 3px;
    border-radius: 8px;
  }
  .tab {
    padding: 5px 14px;
    font-size: 12px;
    color: var(--text-secondary);
    border-radius: 6px;
    transition: all 0.2s;
    cursor: pointer;
  }
  .tab:hover { color: var(--text-primary); }
  .tab.active {
    background: var(--brand-primary);
    color: #ffffff;
    font-weight: 600;
  }

  /* ========== Button ========== */
  .btn {
    padding: 8px 18px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--brand-primary), var(--brand-primary-dark));
    color: #ffffff;
    box-shadow: 0 2px 10px rgba(21, 168, 122, 0.25);
  }
  .btn-primary:hover {
    box-shadow: 0 4px 16px var(--brand-glow);
    transform: translateY(-1px);
  }
  .btn-outline {
    border: 1px solid var(--border-glass-strong);
    color: var(--text-secondary);
    background: transparent;
  }
  .btn-outline:hover {
    border-color: var(--brand-primary);
    color: var(--brand-primary-dark);
    background: rgba(21, 168, 122, 0.06);
  }
  .btn-sm { padding: 5px 12px; font-size: 12px; }

  /* ========== Tag / Status ========== */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11.5px;
    font-weight: 500;
    line-height: 1.6;
  }
  .tag::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }
  .tag-success { color: var(--brand-primary-dark); background: rgba(21, 168, 122, 0.10); }
  .tag-warning { color: var(--accent-orange); background: rgba(217, 138, 43, 0.12); }
  .tag-danger { color: var(--accent-red); background: rgba(217, 83, 74, 0.12); }
  .tag-info { color: var(--accent-blue); background: rgba(47, 155, 214, 0.12); }
  .tag-purple { color: var(--accent-purple); background: rgba(138, 114, 230, 0.12); }

  /* ========== Table ========== */
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .data-table thead th {
    padding: 11px 14px;
    text-align: left;
    font-weight: 600;
    color: var(--text-secondary);
    background: rgba(21, 168, 122, 0.05);
    border-bottom: 1px solid var(--divider);
    font-size: 12.5px;
  }
  .data-table tbody td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--divider);
    color: var(--text-primary);
  }
  .data-table tbody tr:hover {
    background: rgba(21, 168, 122, 0.04);
  }
  .data-table tbody tr:last-child td { border-bottom: none; }

  /* ========== Progress Bar ========== */
  .progress-bar {
    width: 100%;
    height: 6px;
    background: rgba(31,45,58,0.08);
    border-radius: 3px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--brand-primary), var(--brand-primary-light));
    transition: width 1s ease;
  }

  /* ========== Login Page ========== */
  .login-page {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  /* 登录页默认隐藏；只有当前路由激活时才占据视口并居中 */
  .login-page.page {
    display: none;
  }
  .login-page.page.active {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
  }
  .login-bg-shapes {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
  }
  .login-bg-shapes .shape-1 {
    position: absolute;
    top: 10%;
    left: 10%;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(34, 211, 154, 0.15) 0%, transparent 70%);
    filter: blur(40px);
  }
  .login-bg-shapes .shape-2 {
    position: absolute;
    bottom: 10%;
    right: 10%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(79, 195, 247, 0.1) 0%, transparent 70%);
    filter: blur(60px);
  }
  .login-container {
    position: relative;
    z-index: 2;
    width: 960px;
    min-height: 540px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 80px rgba(0,0,0,0.5);
  }
  .login-left {
    background: linear-gradient(160deg, #0e3d4f 0%, #0a5247 50%, #0a3530 100%);
    padding: 50px 48px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .login-left::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at 30% 30%, rgba(34, 211, 154, 0.18) 0%, transparent 50%);
    animation: floatOrb 8s ease-in-out infinite alternate;
  }
  @keyframes floatOrb {
    0% { transform: translate(0, 0); }
    100% { transform: translate(30px, 30px); }
  }
  .login-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 50px;
    position: relative;
    z-index: 1;
  }
  .login-logo-icon {
    width: 48px;
    height: 48px;
