    background: linear-gradient(135deg, var(--brand-primary), var(--accent-blue));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 24px var(--brand-glow);
  }
  .login-logo-icon svg { width: 28px; height: 28px; color: #ffffff; }
  .login-logo-text {
    font-size: 22px;
    font-weight: 700;
    background: linear-gradient(135deg, #ffffff, #7ff0cf);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.5px;
  }
  .login-logo-sub {
    font-size: 12px;
    color: #9fd9cc;
    margin-top: 2px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .login-hero {
    flex: 1;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .login-hero-title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.3;
    color: #ffffff;
    margin-bottom: 16px;
  }
  .login-hero-title .highlight {
    background: linear-gradient(135deg, #5ee6bd, #7fd8f5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .login-hero-desc {
    color: #b8d4cf;
    font-size: 14px;
    line-height: 1.8;
    max-width: 340px;
  }
  .login-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 40px;
    position: relative;
    z-index: 1;
  }
  .login-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: #c2ddd8;
  }
  .login-feature svg {
    width: 16px;
    height: 16px;
    color: #5ee6bd;
    flex-shrink: 0;
  }
  .login-right {
    background: #ffffff;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid var(--border-glass);
    border-left: none;
    padding: 50px 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .login-title {
    font-size: 24px;
    font-weight: 600;
    color: #1f2d3a;
    margin-bottom: 8px;
  }
  .login-subtitle {
    font-size: 13px;
    color: #8a98a6;
    margin-bottom: 36px;
  }
  .form-group {
    margin-bottom: 20px;
  }
  .form-label {
    display: block;
    font-size: 12.5px;
    color: #5b6b78;
    margin-bottom: 8px;
    font-weight: 500;
  }
  .form-input-wrap {
    position: relative;
  }
  .form-input-wrap svg {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: #8a98a6;
  }
  .form-input {
    width: 100%;
    padding: 11px 14px 11px 42px;
    background: #f4f7f9;
    border: 1px solid #e3eaef;
    border-radius: 8px;
    color: #1f2d3a;
    font-size: 13.5px;
    outline: none;
    transition: all 0.25s ease;
  }
  .form-input:focus {
    border-color: var(--brand-primary);
    box-shadow: 0 0 0 3px rgba(21, 168, 122, 0.12);
  }
  .form-input::placeholder { color: #b6c1cb; }
  .form-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    font-size: 12.5px;
  }
  .checkbox-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #5b6b78;
    cursor: pointer;
  }
  .checkbox-wrap input { accent-color: var(--brand-primary); }
  .link {
    color: var(--brand-primary-dark);
    font-size: 12.5px;
  }
  .link:hover { color: var(--brand-primary); }
  .login-btn {
    width: 100%;
    padding: 12px;
    background: linear-gradient(135deg, var(--brand-primary), var(--brand-primary-dark));
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(21, 168, 122, 0.30);
    letter-spacing: 1px;
  }
  .login-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 28px var(--brand-glow);
  }
  @keyframes loginShake {
    0%, 100% { transform: translateX(0); }
    15% { transform: translateX(-7px); }
    30% { transform: translateX(6px); }
    45% { transform: translateX(-5px); }
    60% { transform: translateX(4px); }
    75% { transform: translateX(-2px); }
  }
  .login-shake { animation: loginShake .45s ease; }
  .login-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 24px 0;
    color: var(--text-tertiary);
    font-size: 12px;
  }
  .login-divider::before,
  .login-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--divider);
  }
  .login-alt {
    display: flex;
    justify-content: center;
    gap: 14px;
  }
  .login-alt-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-glass);
    background: #f4f7f9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5b6b78;
    transition: all 0.2s;
    cursor: pointer;
  }
  .login-alt-btn:hover {
    border-color: var(--brand-primary);
    color: var(--brand-primary-dark);
    background: rgba(21, 168, 122, 0.06);
    transform: translateY(-2px);
  }
  .login-alt-btn svg { width: 18px; height: 18px; }

  /* ========== Page Header ========== */
  .page-header {
    margin-bottom: 20px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }
  .page-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .page-desc {
    font-size: 13px;
    color: var(--text-tertiary);
  }
  .page-header-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* ========== Alert Detail Page ========== */
  .alert-detail-header {
    background: var(--bg-card);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    padding: 24px 28px;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--l-shadow-card);
  }
  .alert-detail-header::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: linear-gradient(to bottom, var(--accent-red), var(--accent-orange));
  }
  .alert-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--text-tertiary);
    margin-bottom: 14px;
  }
  .alert-breadcrumb svg { width: 12px; height: 12px; }
  .alert-detail-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }
  .alert-detail-title h2 {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .alert-meta {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 13px;
    color: var(--text-secondary);
    flex-wrap: wrap;
  }
  .alert-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .alert-meta-item svg { width: 14px; height: 14px; color: var(--text-tertiary); }
  .alert-meta-item strong {
    color: var(--text-primary);
    font-weight: 500;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
  }
  .detail-section-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .detail-section-title::before {
    content: '';
    width: 3px;
    height: 14px;
    background: linear-gradient(to bottom, var(--brand-primary), transparent);
    border-radius: 2px;
  }

  .timeline {
    position: relative;
    padding-left: 24px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--divider);
  }
  .timeline-item {
    position: relative;
    padding-bottom: 20px;
  }
  .timeline-item:last-child { padding-bottom: 0; }
  .timeline-dot {
    position: absolute;
    left: -24px;
    top: 4px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--bg-deep);
    border: 2px solid var(--brand-primary);
    box-shadow: 0 0 0 3px rgba(34, 211, 154, 0.1);
  }
  .timeline-dot.danger { border-color: var(--accent-red); box-shadow: 0 0 0 3px rgba(239, 83, 80, 0.1); }
  .timeline-dot.warning { border-color: var(--accent-orange); box-shadow: 0 0 0 3px rgba(255, 183, 77, 0.1); }
  .timeline-dot.info { border-color: var(--accent-blue); box-shadow: 0 0 0 3px rgba(79, 195, 247, 0.1); }
  .timeline-time {
    font-size: 12px;
    color: var(--text-tertiary);
    margin-bottom: 4px;
  }
  .timeline-content {
    font-size: 13px;
    color: var(--text-primary);
    line-height: 1.6;
  }
  .timeline-content .person {
    color: var(--brand-primary-light);
    font-weight: 500;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .info-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--divider);
  }
  .info-item:last-child { border-bottom: none; padding-bottom: 0; }
  .info-label {
    font-size: 12.5px;
    color: var(--text-tertiary);
    flex-shrink: 0;
  }
  .info-value {
    font-size: 13px;
    color: var(--text-primary);
    text-align: right;
    max-width: 60%;
  }

  /* ========== Device List small ========== */
  .device-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--divider);
  }
  .device-item:last-child { border-bottom: none; }
  .device-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgba(21, 168, 122, 0.10);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-primary-dark);
    flex-shrink: 0;
  }
  .device-icon svg { width: 20px; height: 20px; }
  .device-info { flex: 1; min-width: 0; }
  .device-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 3px;
  }
  .device-loc {
    font-size: 11.5px;
    color: var(--text-tertiary);
  }
  .device-val {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-red);
    font-variant-numeric: tabular-nums;
  }

  /* ========== Scrollbar ========== */
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb {
    background: rgba(31,45,58,0.18);
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover { background: rgba(31,45,58,0.30); }

  /* ========== Utility ========== */
  .text-up { color: var(--accent-red); }
  .text-down { color: var(--brand-primary); }
  .text-secondary { color: var(--text-secondary); }
  .text-tertiary { color: var(--text-tertiary); }
  .text-primary { color: var(--text-primary); }
  .text-brand { color: var(--brand-primary); }
  .flex { display: flex; }
  .flex-center { display: flex; align-items: center; justify-content: center; }
  .flex-between { display: flex; align-items: center; justify-content: space-between; }
  .gap-8 { gap: 8px; }
  .gap-12 { gap: 12px; }
  .gap-16 { gap: 16px; }
  .mb-0 { margin-bottom: 0; }
  .mb-16 { margin-bottom: 16px; }
  .mb-20 { margin-bottom: 20px; }
  .mt-8 { margin-top: 8px; }

  /* ========== Radar-like ring chart (CSS) ========== */
  .ring-chart {
    position: relative;
    width: 100%;
    height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ring-center {
    text-align: center;
    z-index: 2;
  }
  .ring-center-val {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }
  .ring-center-label {
    font-size: 12px;
    color: var(--text-tertiary);
    margin-top: 4px;
  }

  /* ========== Legend ========== */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-secondary);
  }
  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: currentColor;
  }

  /* ========== Rank list ========== */
  .rank-list { display: flex; flex-direction: column; gap: 12px; }
  .rank-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .rank-num {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 600;
    flex-shrink: 0;
  }
  .rank-item:nth-child(1) .rank-num { background: linear-gradient(135deg, #ffb74d, #ff9800); color: #2a1a00; }
  .rank-item:nth-child(2) .rank-num { background: linear-gradient(135deg, #b0bec5, #78909c); color: #1a2529; }
  .rank-item:nth-child(3) .rank-num { background: linear-gradient(135deg, #d7a86e, #b8860b); color: #2a1f00; }
  .rank-item:nth-child(n+4) .rank-num { background: rgba(255,255,255,0.06); color: var(--text-tertiary); }
  .rank-name { flex: 1; font-size: 13px; color: var(--text-primary); }
  .rank-val {
    font-size: 13px;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
    margin-right: 8px;
    min-width: 60px;
    text-align: right;
  }
  .rank-bar {
    width: 80px;
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: 3px;
    overflow: hidden;
  }
  .rank-bar-fill {
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--brand-primary), var(--brand-primary-light));
  }

  /* ========== Park Info Bar ========== */
  .park-info-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    margin-bottom: 20px;
    background: var(--bg-card);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    box-shadow: var(--l-shadow-card);
  }
  .park-info-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .park-name {
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .park-name-badge {
    font-size: 10px;
    padding: 2px 8px;
    background: linear-gradient(135deg, rgba(21,168,122,0.14), rgba(47,155,214,0.14));
    border: 1px solid var(--border-glass-strong);
    color: var(--brand-primary-dark);
    border-radius: 4px;
    letter-spacing: 0.5px;
    font-weight: 500;
  }
  .park-stats {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .park-stat {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--text-secondary);
  }
  .park-stat svg { width: 15px; height: 15px; color: var(--brand-primary); }
  .park-stat strong {
    color: var(--text-primary);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* ========== Energy Flow (Sankey-like) ========== */
  .energy-flow {
    position: relative;
    width: 100%;
    height: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
  }
  .flow-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
  }
  .flow-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    background: rgba(21,168,122,0.10);
    border: 1px solid rgba(34, 211, 154, 0.15);
    border-radius: 8px;
    min-width: 90px;
    transition: all 0.3s;
  }
  .flow-node:hover {
    background: rgba(34, 211, 154, 0.12);
    border-color: var(--brand-primary);
    transform: translateY(-2px);
  }
  .flow-node-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-primary);
  }
  .flow-node-icon svg { width: 24px; height: 24px; }
  .flow-node-name { font-size: 12px; color: var(--text-primary); font-weight: 500; }
  .flow-node-val { font-size: 11px; color: var(--text-tertiary); font-variant-numeric: tabular-nums; }

  .flow-node.solar { background: rgba(255,183,77,0.06); border-color: rgba(255,183,77,0.15); }
  .flow-node.solar .flow-node-icon { color: var(--accent-orange); }
  .flow-node.storage { background: rgba(171,146,255,0.06); border-color: rgba(171,146,255,0.15); }
  .flow-node.storage .flow-node-icon { color: var(--accent-purple); }
  .flow-node.grid { background: rgba(79,195,247,0.06); border-color: rgba(79,195,247,0.15); }
  .flow-node.grid .flow-node-icon { color: var(--accent-blue); }
  .flow-node.center {
    background: linear-gradient(135deg, rgba(34,211,154,0.12), rgba(79,195,247,0.08));
    border-color: var(--brand-primary);
    padding: 16px 28px;
    min-width: 160px;
    box-shadow: 0 0 30px rgba(34,211,154,0.1);
  }
  .flow-node.center .flow-node-name { font-size: 14px; }
  .flow-node.center .flow-node-val { font-size: 20px; font-weight: 700; color: var(--brand-primary-light); }

  .flow-lines {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
  }
  .flow-lines svg { width: 100%; height: 100%; }
  .flow-path {
    fill: none;
    stroke: rgba(34, 211, 154, 0.25);
    stroke-width: 2;
    stroke-dasharray: 6 4;
    animation: flowDash 2s linear infinite;
  }
  @keyframes flowDash {
    to { stroke-dashoffset: -20; }
  }

  /* ========== Source-Grid-Load-Storage ========== */
  .sgls-list { display: flex; flex-direction: column; gap: 16px; }
  .sgls-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sgls-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
  }
  .sgls-label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    font-weight: 500;
  }
  .sgls-label svg { width: 16px; height: 16px; color: var(--sgls-color, var(--brand-primary)); }
  .sgls-value {
    color: var(--text-secondary);
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
  }
  .sgls-value strong { color: var(--text-primary); font-weight: 600; margin-right: 4px; }
  .sgls-bar {
    height: 8px;
    background: rgba(255,255,255,0.05);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }
  .sgls-bar-fill {
    height: 100%;
    border-radius: 4px;
    background: linear-gradient(90deg, var(--sgls-color, var(--brand-primary)), var(--brand-primary-light));
    transition: width 1s ease;
  }

  /* ========== AI Strategy Card ========== */
  .ai-strategy-card {
    background: linear-gradient(135deg, rgba(21,168,122,0.10), rgba(47,155,214,0.06));
