function zsPause(btn){document.getElementById('zs-stage').classList.toggle('zs-paused');btn.style.color=document.getElementById('zs-stage').classList.contains('zs-paused')?'#ffc65a':''}
function zsFull(){const e=document.getElementById('page-zero-screen');document.fullscreenElement?document.exitFullscreen?.():e.requestFullscreen?.()}
/* 大屏右上角“返回综合看板”：先退出全屏，确保切换路由时 app-shell 不被全屏大屏遮盖，再跳转综合看板 */
function zsGoCockpit(){if(document.fullscreenElement){document.exitFullscreen?.()}goTo('cockpit')}
