/* 等比缩放：用统一缩放系数 scale(min(sx,sy)) 保持 1920×1080 比例不变形，
   居中放置并留出背景余量，避免非等比 scale(sx,sy) 把标题与卡片字体拉长变形。 */
function zsFit(){const s=document.getElementById('zs-stage');if(!s)return;const w=innerWidth,h=innerHeight,sx=w/1920,sy=h/1080,k=Math.min(sx,sy);s.style.transform=`translate(-50%,-50%) scale(${k})`}
function zsClock(){const d=new Date(),p=n=>String(n).padStart(2,'0'),w=['星期日','星期一','星期二','星期三','星期四','星期五','星期六'];const c=document.getElementById('zs-clock');if(c)c.textContent=`${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;const e=document.getElementById('zs-week');if(e)e.textContent=w[d.getDay()]}
function zsSelect(el){document.querySelectorAll('.zs-building').forEach(x=>x.classList.remove('active'));el.classList.add('active');document.getElementById('zs-fn').textContent=el.dataset.name;document.getElementById('zs-fp').textContent=el.dataset.power;document.getElementById('zs-fc').textContent=el.dataset.carbon;document.getElementById('zs-fe').textContent=el.dataset.eff}
function zsCruise(){clearInterval(zsTimer);zsTimer=setInterval(()=>{if(getRoute()!=='zero_screen')return;const a=[...document.querySelectorAll('.zs-building')];if(a.length){zsIndex=(zsIndex+1)%a.length;zsSelect(a[zsIndex])}},4500)}
