    initChart('chart-usage-category', getUsageCategoryOption());
    initChart('chart-load-curve', getLoadCurveOption());
    initChart('chart-saving-potential', getSavingPotentialOption());
    renderEfficiencyTable();
    renderTopEnterprise();
  }

  if (route === 'carbon') {
    initChart('chart-carbon-monthly', getCarbonMonthlyOption());
