/* V6 side-panel live auto scrolling */
const z6Scrollers=[];
function z6InitPanelScroll(){document.querySelectorAll('#page-zero-screen .zs-side .zs-panel:not(.zs-panel-fixed) .zs-pb').forEach((el,i)=>{if(el.dataset.z6scroll)return;el.dataset.z6scroll='1';el.classList.add('is-auto-scrolling');let dir=1,paused=false;const state={el,dir,paused,timer:null,startAt:Date.now()+60000};const tick=()=>{if(Date.now()<state.startAt||getRoute()!=='zero_screen'||state.paused||el.scrollHeight<=el.clientHeight+2)return;el.scrollTop+=state.dir;if(el.scrollTop>=el.scrollHeight-el.clientHeight-1)state.dir=-1;if(el.scrollTop<=0)state.dir=1};state.timer=setInterval(tick,58+i*5);el.addEventListener('mouseenter',()=>state.paused=true);el.addEventListener('mouseleave',()=>state.paused=false);el.addEventListener('wheel',()=>{state.paused=true;clearTimeout(state.resume);state.resume=setTimeout(()=>state.paused=false,2600)},{passive:true});z6Scrollers.push(state)})}
window.addEventListener('load',()=>setTimeout(()=>{document.querySelectorAll('.top10-scroll').forEach(e=>e.scrollTop=0);z6InitPanelScroll()},300));

function z21RenderClean(){const d=document.getElementById('z21-clean-donut');if(!d)return;let n=0,a=[];document.querySelectorAll('#z21-clean-legend>div').forEach((r,i)=>{const v=[46.2,28.4,18,7.4][i],c=r.classList.contains('is-hidden')?'#64758a':['#56f1c0','#4fc9f3','#ffd166','#f3b6c8'][i];a.push(`${c} ${n}% ${n+v}%`);n+=v});d.style.background=`conic-gradient(${a.join(',')})`}
function z21ToggleClean(ev,row){if(ev)ev.stopPropagation();row.classList.toggle('is-hidden');z21RenderClean()}
function z21CloseBuilding(ev){if(ev)ev.stopPropagation();const c=document.getElementById('building-status-card');if(c)c.classList.remove('is-visible');document.querySelectorAll('.z5-pin').forEach(x=>x.classList.remove('active'))}
function z21SelectEnterprise(row){const name=row.dataset.enterprise.replace(/\s/g,'');const pin=[...document.querySelectorAll('.z5-pin')].find(p=>p.dataset.name.replace(/\s/g,'')===name);if(pin)z5Select({stopPropagation(){}},pin)}
/* V26: 企业绿电消费TOP10 - 今日/本月切换 */
function v25RankTab(type,btn){const card=document.querySelector('.v25-rank-card');if(!card)return;card.querySelectorAll('.v25-ptab').forEach(b=>b.classList.toggle('active',b===btn));const today=document.getElementById('v25-rank-today'),month=document.getElementById('v25-rank-month');if(today)today.style.display=type==='today'?'':'none';if(month)month.style.display=type==='month'?'':'none'}
/* V26: 点击排行企业 → 地图弹出对应楼宇状态卡片 */
function v25RankClickEnterprise(row){const name=row.dataset.enterprise.replace(/\s/g,'');const pin=[...document.querySelectorAll('.z5-pin')].find(p=>p.dataset.name.replace(/\s/g,'')===name);if(pin)z5Select({stopPropagation(){}},pin)}
function v25RankBindClick(){document.querySelectorAll('#v25-rank-track .v25-rank-row').forEach(r=>{if(r.dataset.v26)return;r.dataset.v26='1';r.style.cursor='pointer';r.addEventListener('click',e=>{e.stopPropagation();v25RankClickEnterprise(r)})})}
window.addEventListener('load',()=>{v25RankBindClick()});

function z21RankTab(btn,type){btn.parentElement.querySelectorAll('.z21-tab').forEach(b=>b.classList.toggle('active',b===btn));document.getElementById('z21-rank-intensity').style.display=type==='intensity'?'flex':'none';document.getElementById('z21-rank-clean').style.display=type==='clean'?'flex':'none'}
window.addEventListener('load',()=>{const c=document.getElementById('building-status-card');if(c)c.classList.remove('is-visible');document.querySelectorAll('.z5-pin').forEach(x=>x.classList.remove('active'))});
</script>

