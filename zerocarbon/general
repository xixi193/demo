/* ========== Login handler ========== */
function handleLogin() {
  var username = document.getElementById('login-username').value.trim();
  var password = document.getElementById('login-password').value;
  if (!username) {
    showToast('请输入账号', 'warning');
    document.getElementById('login-username').focus();
    return;
  }
  if (!password) {
    showToast('请输入密码', 'warning');
    document.getElementById('login-password').focus();
    return;
  }
  var btn = document.querySelector('.login-btn');
  if (!btn) { showToast('页面加载异常，请刷新重试', 'error'); return; }
  btn.textContent = '登录中...';
  btn.disabled = true;
  btn.style.opacity = '0.7';
  setTimeout(function() {
    if (username === 'admin' && password === '123456') {
      zcSetAuthed(true);
      showToast('登录成功，欢迎回来！', 'success');
      goTo('zero-screen');
    } else {
      var pw = document.getElementById('login-password');
      if (pw) { pw.value = ''; pw.focus(); }
      var card = document.querySelector('.login-right');
      if (card) {
        card.classList.remove('login-shake');
        void card.offsetWidth;
        card.classList.add('login-shake');
      }
      showToast('账号或密码错误，无法进入系统', 'error');
    }
    btn.textContent = '登录';
    btn.disabled = false;
    btn.style.opacity = '1';
  }, 800);
}

/* 登录页：回车提交 */
document.addEventListener('DOMContentLoaded', function() {
  ['login-username', 'login-password'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') { e.preventDefault(); handleLogin(); }
    });
  });
});
if (document.readyState !== 'loading') {
  setTimeout(function() {
    ['login-username', 'login-password'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el && !el.dataset.enterBound) {
        el.dataset.enterBound = '1';
        el.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') { e.preventDefault(); handleLogin(); }
        });
      }
    });
  }, 0);
}

