/* ========== Enterprise Portal (企业工作台) · single-file embedded surface ========== */
var _entId = 'ent-portal-overlay';
var _enterprisePortalBase64 = '';
function _decodeEnterprisePortal() {
  var binary = atob(_enterprisePortalBase64);
  var bytes = new Uint8Array(binary.length);
  for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return new TextDecoder('utf-8').decode(bytes);
}
function openEnterprisePortal() {
  var overlay = document.getElementById(_entId);
  if (!overlay) {
    overlay = document.createElement('div');
    overlay.id = _entId;
    overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;background:#f2f5f4;';
    overlay.innerHTML = '<div style="position:fixed;top:12px;right:16px;z-index:10000;display:flex;gap:8px;">' +
      '<button onclick="closeEnterprisePortal()" style="height:34px;padding:0 14px;border-radius:5px;border:1px solid #178653;background:rgba(23,134,83,.92);color:#fff;font-size:13px;cursor:pointer;">← 返回管理端</button>' +
      '</div>' +
      '<iframe id="enterprise-portal-frame" title="企业工作台" style="position:fixed;inset:0;width:100%;height:100%;border:none;" frameborder="0" allowfullscreen></iframe>';
    document.body.appendChild(overlay);
    document.getElementById('enterprise-portal-frame').srcdoc = _decodeEnterprisePortal();
  }
  overlay.style.display = 'block';
  showToast('已进入企业工作台', 'success');
}
function closeEnterprisePortal() {
  var overlay = document.getElementById(_entId);
  if (overlay) overlay.style.display = 'none';
  showToast('已返回管理端', 'info');
}
// 浏览器后退快捷键（Esc 关闭）
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    var overlay = document.getElementById(_entId);
    if (overlay && overlay.style.display === 'block') closeEnterprisePortal();
  }
});


